{
  "name": "r-detect",
  "version": "0.1.0",
  "description": "Device similarity scoring for the web: hashed browser signals, an explainable match score, and server helpers.",
  "author": "raeez alshamaly",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/raiez-alshamaly/r-detect.git"
  },
  "homepage": "https://github.com/raiez-alshamaly/r-detect#readme",
  "bugs": {
    "url": "https://github.com/raiez-alshamaly/r-detect/issues"
  },
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist",
    "docs",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./score": {
      "types": "./dist/score.d.ts",
      "default": "./dist/score.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "node tools/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"test/*.test.ts\"",
    "vectors": "node tools/make-vectors.mjs --check",
    "harness": "node tools/serve.mjs",
    "prepack": "npm run typecheck && npm test && npm run vectors && npm run build"
  },
  "keywords": [
    "device",
    "fingerprint",
    "similarity",
    "fraud",
    "abuse",
    "browser"
  ],
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  }
}
